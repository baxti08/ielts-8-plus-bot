# ============================================================
# IELTS 8+ Bot -- environment configuration
# Copy this file to .env and fill in the blanks (marked CHANGE_ME).
# Never commit the real .env to git.
# ============================================================

# --- Telegram bot ---
BOT_TOKEN=CHANGE_ME_get_from_BotFather
BOT_USERNAME=ielts_level_bot

# --- Webhook (bot runs behind Caddy, see DEPLOY.md for why) ---
USE_WEBHOOK=true
WEBHOOK_BASE_URL=https://CHANGE_ME.example.com
WEBHOOK_PATH=/webhook/tg
WEBHOOK_SECRET=CHANGE_ME_random_long_string
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8081

# --- Private source content channels (bot must be admin in each) ---
CHANNEL_READING_ID=-1004415568526
CHANNEL_MULTILEVEL_ID=-1004356238968
CHANNEL_LISTENING_ID=-1004369157403
CHANNEL_SPEAKING_ID=-1004425106652
CHANNEL_WRITING_ID=-1003695165186

# --- Required subscription-gate channels (public, bot must be admin in each
#     so it receives chat_member updates for leave/rejoin detection) ---
REQ_CHANNEL_1_USERNAME=MultiLevelRecord
REQ_CHANNEL_1_NAME=Multi-Level Record

REQ_CHANNEL_2_USERNAME=RS_IELTS
REQ_CHANNEL_2_NAME=Sirojiddin's blog

REQ_CHANNEL_3_USERNAME=alisher_abduvohobov
REQ_CHANNEL_3_NAME=Alisher's IELTS | 9.0

REQ_CHANNEL_4_USERNAME=xojaevs
REQ_CHANNEL_4_NAME=Muxriddin Xujaev | IELTS

RESULTS_LINK=https://t.me/level_results/2

# --- Database ---
POSTGRES_DB=ielts_bot
POSTGRES_USER=ielts_bot
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ielts_bot:CHANGE_ME_strong_password@postgres:5432/ielts_bot
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30

# --- Daily DB backup (sent via Telegram to the admin every morning) ---
BACKUP_ADMIN_CHAT_ID=8233724149
BACKUP_HOUR=8
BACKUP_MINUTE=0

# --- Admin panel ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=baxti777
ADMIN_SECRET_KEY=CHANGE_ME_random_long_string_for_cookie_signing
ADMIN_DOMAIN=CHANGE_ME.example.com

# --- Referral economics ---
REFERRALS_PER_SLOT=3

# --- Broadcast pacing ---
BROADCAST_RATE_PER_SEC=28

# --- Bot-side admin commands (/broadcast, /broadcast_status) ---
ADMIN_IDS=8233724149

# --- Misc ---
LOG_LEVEL=INFO
TZ=Asia/Tashkent
